<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:id="@+id/w_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Heures du jour"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 h 00"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_ot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="Touchez une étape pour noter vos heures"
        android:textColor="#E6F1FF"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/w_prep" style="@style/WidgetStep" android:text="Prépa" />
        <TextView android:id="@+id/w_trajet" style="@style/WidgetStep" android:text="Aller" />
        <TextView android:id="@+id/w_inter" style="@style/WidgetStep" android:text="Sur place" />
        <TextView android:id="@+id/w_pause" style="@style/WidgetStep" android:text="Pause" />
        <TextView android:id="@+id/w_retour" style="@style/WidgetStep" android:text="Retour" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_valider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_btn_main"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="Vérifier et valider"
        android:textColor="#0E7E76"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
